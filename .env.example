# Copy to .env and adjust. Real environment variables always win over .env.
DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5432/ledgerline
TEST_DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5432/ledgerline_test
APP_ENV=development
# Signs login tokens. In production: a long random value (python -m app.cli keygen).
SECRET_KEY=change-me-to-a-long-random-string-0123456789
# Signs journal entries. Set once, never change (old signatures would stop verifying).
LEDGER_SIGNING_KEY=
# Optional. Without it, AI review notes use a deterministic template.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
